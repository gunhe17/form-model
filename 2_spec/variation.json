 "검토_3단계": {
  "셀 치수": "157페이지 전수 재산정 + dpi 불변성 검증 통과(오차 4%) + 오버레이 육안 확인(서식2호 45/45 진짜 셀)",
  "셀 여백": "신규 측정 — 절차에 있었으나 v1에서 누락",
  "괘선 두께": "⚠ 렌더 아티팩트 — 벡터 헤어라인은 dpi 무관 최소 1px 로 그려져 정규화가 무효(100/200dpi 오차 100%). 해석: 원본은 대부분 헤어라인 + 소수 강조선. 생성기는 1px 기본·3px 강조로 그리되, 두꺼워 보이는 효과는 dpi 랜덤화가 담당 — 두께 랜덤화와 이중 적용 금지",
  "글자 높이": "⚠ dpi 민감(33%) — 근사치로 강등. 생성기는 pt 단위(9~14pt)로 정하고 렌더 dpi가 픽셀 크기를 결정",
  "글리프": "1차 검토에서 정정 완료(육안 12~22px)",
  "배경 음영": "미해결 — 정량화 실패, 정책값(#E0E0E0) 유지"
 },
 "검토_3단계_2차": {
  "여백 정정": "'좌측 여백 23px'은 무의미한 혼합값 — 셀 89%가 가운데 정렬이라 좌여백 개념 자체가 소수(9%)에만 적용. 정렬 비율(89/9/2)을 신규 파라미터로",
  "불변성 표본": "1종→3종 확대. 셀높이 2~8% 통과 · 여백 9~16% 근사치 등급",
  "하한 절단": "셀 치수 min 은 검출 필터(h>12px 렌더)에 절단됨 — 실제 최소는 더 작을 수 있음",
  "글리프 상한": "서식4-1호 크기대역으로 상한 21px 확정. 이봉 분포로 생성"
 },
 "검토_3단계_3차": {
  "정렬 분류": "오버레이 육안 검증 통과 — 가운데=라벨 셀, 왼쪽=내용 행, 오른쪽=단위 셀에 정확히 대응",
  "빈 셀 순도": "라벨 18페이지 570/570 — 단 서식 페이지 한정, 관대한 판정",
  "글리프": "제3표본(서식15호)이 대형 모드 재확인 — 이봉 확정, 상한 22로 미세 확장",
  "음영": "정책 → 실측 승격 (모드 201·229). 단 출처 혼합 단서"
 }
