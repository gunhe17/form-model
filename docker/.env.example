# cp .env.example .env 후 채울 것. .env 는 커밋하지 않는다.
WORKSPACE=/home/ghkim/workspace/lab/form-model   # 서버의 전용 프로젝트 폴더
UID=1001                                             # id -u 결과
GPU=1
MEM=48g
CPUS=12

# 둘 중 하나. 키 대신 컨테이너 안에서 `claude login` 해도 claude-auth 볼륨에 남는다.
ANTHROPIC_API_KEY=

GIT_AUTHOR_NAME=agent
GIT_AUTHOR_EMAIL=agent@form-model
GIT_COMMITTER_NAME=agent
GIT_COMMITTER_EMAIL=agent@form-model
